# Admin / owner token (also accepted as X-Token / Bearer)
AGENT_MANAGER_TOKEN=replace-me
AGENT_MANAGER_PORT=8075

# Optional: override brain config path (default ~/.config/agent-manager/config.json)
# AGENT_MANAGER_CONFIG=/path/to/config.json

# First-time users create a token at /setup/ when none exist (bootstrap).
# To let additional people mint tokens on a running brain:
# ALLOW_PUBLIC_SIGNUP=1
# Optional shared invite code required when signup is open:
# SETUP_INVITE_CODE=your-invite
